# DeepSeek API Key（真实出题/报告必填；mock 开发阶段可为空）
DEEPSEEK_API_KEY=

# 大模型名（性价比档位；出题质量不足时升级 deepseek-v4-pro）
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI 兼容兜底地址（可选：langchain-deepseek 官方集成不可用时启用，如 https://api.deepseek.com）
DEEPSEEK_BASE_URL=

# LLM 单次调用超时（秒）
LLM_TIMEOUT=60

# 日志级别：INFO=事件摘要（默认）；DEBUG=输出模型调用输入/输出、工具调用入出参等完整内容（含用户输入原文，生产慎用）
LOG_LEVEL=INFO

# 出题/报告任务整体超时（秒）
TASK_TIMEOUT_SECONDS=120

# 内存任务保留时长（秒，30 分钟）
TASK_TTL_SECONDS=1800

# 可选：自定义敏感词表文件路径（每行一词，与内置词表合并）
SENSITIVE_WORDS_FILE=

# 海报二维码默认指向（上线时配置为小程序 URL Link）
SHARE_URL=https://example.com

# --- MySQL（Docker Compose，容器 ai-learn-mysql）---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_learn
MYSQL_PASSWORD=<数据库密码>
MYSQL_DB=ai_learn

# --- JWT 鉴权 ---
JWT_SECRET=<密钥>
JWT_EXPIRE_DAYS=7

# --- 微信登录（AUTH_MOCK=true 时可不填）---
WECHAT_APPID=<AppID>
WECHAT_SECRET=<AppSecret>
AUTH_MOCK=true
AUTH_MOCK_OPENID=mock-user

# --- 联网搜索增强出题（Tavily，免费 1000 次/月）---
SEARCH_ENABLED=true
TAVILY_API_KEY=<密钥>
SEARCH_RESULT_MAX_CHARS=4000

# --- 私有知识库 RAG（阿里云百炼文本向量模型 qwen3.7-text-embedding）---
# 总开关；关闭后上传文档被拒绝、出题跳过知识库段（行为与未接入时一致）
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=<密钥>
# OpenAI 兼容端点；sk-ws- 前缀密钥可能需 WorkspaceId 专属域名：
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 单批向量化条数（对齐百炼批量上限 20）
EMBEDDING_BATCH_SIZE=20

# --- 知识库检索与分块参数 ---
# 上传文档大小上限（MB）
KB_MAX_FILE_SIZE_MB=10
# 检索候选数（检索 k=2*TOP_K 后按阈值过滤）
KB_TOP_K=6
# 片段相似度硬过滤阈值
KB_MIN_SCORE=0.3
# 分块字数 / 重叠字数
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50

# --- 错题重练（艾宾浩斯遗忘曲线）---
# 复习间隔序列（天，逗号分隔；当前状态机以代码常量 REVIEW_INTERVAL_DAYS 为权威，此为运维预留）
REVIEW_INTERVAL_DAYS=1,2,4,7
# 每日订阅消息提醒执行时点（本地时区 0~23）
REVIEW_PUSH_HOUR=9
# 复习提醒订阅消息模板 ID（微信小程序后台申请；空或 AUTH_MOCK=true 时仅记日志不发真实消息）
WECHAT_TMPL_REVIEW=<模板ID>
