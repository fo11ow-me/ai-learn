# DeepSeek API Key（真实出题/报告必填；mock 开发阶段可为空）
DEEPSEEK_API_KEY=

# 大模型名（性价比档位；出题质量不足时升级 deepseek-v4-pro）
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI 兼容兜底地址（可选：langchain-deepseek 官方集成不可用时启用，如 https://api.deepseek.com）
DEEPSEEK_BASE_URL=

# LLM 单次调用超时（秒）
LLM_TIMEOUT=60

# 日志级别：INFO=事件摘要（默认）；DEBUG=输出模型调用输入/输出、工具调用入出参等完整内容（含用户输入原文，生产慎用）
LOG_LEVEL=INFO

# 出题/报告任务整体超时（秒）
TASK_TIMEOUT_SECONDS=120

# 内存任务保留时长（秒，30 分钟）
TASK_TTL_SECONDS=1800

# 可选：自定义敏感词表文件路径（每行一词，与内置词表合并）
SENSITIVE_WORDS_FILE=

# 海报二维码默认指向（上线时配置为小程序 URL Link）
SHARE_URL=https://example.com

# --- MySQL（Docker Compose，容器 ai-learn-mysql）---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_learn
MYSQL_PASSWORD=<数据库密码>
MYSQL_DB=ai_learn

# --- JWT 鉴权 ---
JWT_SECRET=<密钥>
JWT_EXPIRE_DAYS=7

# --- 微信登录（AUTH_MOCK=true 时可不填）---
WECHAT_APPID=<AppID>
WECHAT_SECRET=<AppSecret>
AUTH_MOCK=true
AUTH_MOCK_OPENID=mock-user

# --- 联网搜索增强出题（Tavily，免费 1000 次/月）---
SEARCH_ENABLED=true
TAVILY_API_KEY=<密钥>
SEARCH_RESULT_MAX_CHARS=4000
